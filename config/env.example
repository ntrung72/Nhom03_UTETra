# BƯỚC 44 · Example environment variables (not real secrets)
# Windows CMD: set DB_URL=...  | PowerShell: $env:DB_URL='...'
# Do not commit .env, credentials, signing keys, or private upload files.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UTETraDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=REPLACE_WITH_LOCAL_SQL_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
REMEMBER_ME_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_KEY
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8090/payments/vnpay/return
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:8090/payments/momo/return
MOMO_IPN_URL=http://localhost:8090/payments/momo/ipn
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private-uploads
WS_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
SEED_DATA=false
OPENAPI_PUBLIC=false
